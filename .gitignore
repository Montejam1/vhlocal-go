# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp

# vhlocal runtime output — these default to OUTSIDE the repo (~/vulnhunter-reports,
# ~/.vhlocal), but guard against a --reports-dir / VHLOCAL_LOG_DIR pointed here.
vulnhunter-reports/
.vhlocal/
*.log

# Local scratch
scratch/
tmp/

# Vite build output for the React UI (regenerate with: cd web-react && npm run build)
node_modules/
playwright-report/
test-results/
vhlocal/web/app/

# Go (port)
*.exe
*.test
*.out
/vendor/
/dist/
# built binary at repo root (named `vhlocal`) — but NOT the Python package dir vhlocal/
/vhlocal
!/vhlocal/
# built React bundle embedded at build time (regenerated by `make ui`)
/vhlocal/web/app/
/bin/

# Operator-store fingerprint listings (feature 015/016 validation). The digests in
# *.summary are the evidence that the stores were unchanged; the raw listings enumerate
# every file under ~/.vhlocal and ~/vulnhunter-reports with absolute paths, sizes, mtimes
# and hashes, which is operator-private inventory and does not belong in the repository.
validation-*/fingerprint-*.txt
validation-*/fingerprint-*.txt.hashes

# Stray build output: a binary accidentally built into the Python package directory, and an
# SBOM written by a test run against testdata/vulnapp.
/vhlocal/vhlocal
/sbom.cdx.json
